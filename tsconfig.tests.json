{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": ".tmp-tests",
        "module": "commonjs",
        "types": ["node"],
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@extensions/*": ["./src/extensions/*"]
        }
    },
    "include": [
        "tests/**/*.ts",
        "src/extensions/shell.ts"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}
